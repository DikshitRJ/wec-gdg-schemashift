# -----------------------------------------------------------------------------
# SchemaShift Environment Configuration Template
# Copy this file to .env and customize as needed:
#   cp .env.example .env
# -----------------------------------------------------------------------------

# --- Database Connections ---
MONGO_URI=mongodb://localhost:27017
PG_URI=postgresql://schemashift:schemashift@localhost:5432/schemashift

# --- LLM Provider Settings ---
# Options: "none" (pure deterministic), "replay" (cached zero-shot), "openai" (OpenAI-compatible endpoint)
SCHEMASHIFT_LLM_PROVIDER=replay

# Base URL for OpenAI-compatible LLM endpoints:
# - Google Gemini OpenAI endpoint: https://generativelanguage.googleapis.com/v1beta/openai/
# - OpenAI official API: https://api.openai.com/v1
# - Local vLLM / Ollama: http://localhost:11434/v1
SCHEMASHIFT_LLM_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/

# API key for the chosen LLM provider (not needed for provider=none or provider=replay)
SCHEMASHIFT_LLM_API_KEY=your_api_key_here

# Target LLM model name
# Examples: gemini-2.5-flash, gpt-4o-mini, claude-3-5-sonnet-20241022
SCHEMASHIFT_LLM_MODEL=gemini-2.5-flash

# --- Runtime / Application Settings ---
# Toggle data backend: "sql" (PostgreSQL via SQLAlchemy) or "mongo" (legacy MongoDB)
DATA_BACKEND=sql
